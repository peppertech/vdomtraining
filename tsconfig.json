{
  "compileOnSave": true,
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "strict": true,
    "module": "amd",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "esnext.asynciterable",
      "es2022"
    ],
    "typeRoots": [
      "./node_modules/@oracle/oraclejet/dist/types",
      "./node_modules/@types",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "ojs/*": [
        "./node_modules/@oracle/oraclejet/dist/types/*"
      ],
      "@oracle/oraclejet-preact/*": [
        "./node_modules/@oracle/oraclejet-preact/*"
      ],
      "oj-c/*": [
        "./node_modules/@oracle/oraclejet-core-pack/oj-c/types/*"
      ],
      "preact": [
        "./node_modules/preact"
      ],
      "oj-ehrc-person-search/*": [
        "./exchange_components/oj-ehrc-person-search/types/*"
      ],
      "oj-ehrc-resources/*": [
        "./exchange_components/oj-ehrc-resources/types/*"
      ],
      "my-test/*": [
        "./src/components/my-test/*"
      ]
    },
    "declaration": true,
    "noEmitOnError": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "removeComments": true,
    "allowJs": false
  },
  "include": [
    "./src/**/*"
  ]
}